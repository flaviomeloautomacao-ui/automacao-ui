// Prisma Schema — Automação de Laudos Técnicos
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────

enum JobStatus {
  queued
  processing
  done
  error
}

// ─── Models ───────────────────────────────────────────────

model Job {
  id           String    @id @default(uuid()) @db.Uuid
  filename     String?
  profile      String    // ex: "dust", "gas", "vapors"
  status       JobStatus @default(queued)
  progress     Int?      @default(0) // 0-100
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("jobs")
}

// ─── Tabelas pré-existentes (Supabase) ────────────────────

/// Esta tabela já existia no Supabase (não gerenciada por migrations).
/// Contains row level security. See: https://pris.ly/d/row-level-security
model konis_db {
  id        BigInt                 @id @default(autoincrement())
  content   String?
  metadata  Json?
  embedding Unsupported("vector")?
}
